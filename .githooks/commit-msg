#!/usr/bin/env python3
"""Reject commit messages that do not follow Conventional Commits 1.0.0.

https://www.conventionalcommits.org/en/v1.0.0/
"""

import re
import subprocess
import sys
from pathlib import Path

SPEC = "https://www.conventionalcommits.org/en/v1.0.0/"

# The spec allows any noun as a type. A fixed list also catches typos.
TYPES = (
    "feat",
    "fix",
    "build",
    "chore",
    "ci",
    "docs",
    "perf",
    "refactor",
    "revert",
    "style",
    "test",
)

HEADER = re.compile(
    r"(?P<type>[^\s(:!]+)"
    r"(?:\([^()\s](?:[^()]*[^()\s])?\))?"
    r"!?"
    r": \S.*"
)
AUTOSQUASH = re.compile(r"(?:fixup|squash|amend)! ")
FOOTER = re.compile(r"(?:[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*|BREAKING CHANGE)(?:: | #)\S")
BREAKING_ANY_FORM = re.compile(r"breaking[ -]change\s*[:#]", re.IGNORECASE)
BREAKING_VALID = re.compile(r"BREAKING[ -]CHANGE: \S")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=False)


def comment_prefix():
    for key in ("core.commentString", "core.commentChar"):
        value = git("config", "--get", key).stdout.strip()
        if value and value != "auto":
            return value
    return "#"


def strip_git_additions(message, comment):
    """Drop what git adds to the editor buffer and will not commit."""
    scissors = re.compile(re.escape(comment) + r" -+ >8 -+")
    lines = []
    for line in message.splitlines():
        if scissors.fullmatch(line.rstrip()):
            break
        if not line.startswith(comment):
            lines.append(line.rstrip())
    return "\n".join(lines).strip("\n")


def is_exempt(message):
    """Merge commits and autosquash markers are written by git, not an author."""
    merging = git("rev-parse", "-q", "--verify", "MERGE_HEAD").returncode == 0
    return merging or AUTOSQUASH.match(message) is not None


def check_breaking_footers(lines):
    errors = []
    for index, line in enumerate(lines):
        if index == 0 or not BREAKING_ANY_FORM.match(line):
            continue
        if not BREAKING_VALID.match(line):
            errors.append(
                "a breaking change footer must read "
                f"'BREAKING CHANGE: <description>', in uppercase: {line!r}"
            )
            continue
        start = index
        while start > 1 and lines[start - 1]:
            start -= 1
        if not FOOTER.match(lines[start]):
            errors.append(f"a breaking change footer needs a blank line before it: {line!r}")
    return errors


def validate(message):
    lines = message.split("\n")
    errors = []
    header = HEADER.fullmatch(lines[0])
    if header is None:
        errors.append(f"the first line must read '<type>[(scope)][!]: <description>': {lines[0]!r}")
    elif header["type"].lower() not in TYPES:
        errors.append(f"unknown type {header['type']!r}")
    if len(lines) > 1 and lines[1]:
        errors.append("the body must begin after one blank line")
    return errors + check_breaking_footers(lines)


def main():
    raw = Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")
    message = strip_git_additions(raw, comment_prefix())
    if not message or is_exempt(message):
        return 0
    errors = validate(message)
    if not errors:
        return 0
    print("commit-msg: rejected, this is not a Conventional Commits message.", file=sys.stderr)
    for error in errors:
        print(f"  - {error}", file=sys.stderr)
    print(f"Types: {', '.join(TYPES)}", file=sys.stderr)
    print(f"Spec: {SPEC}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
